{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/collapseindex/dinostomp/main/src/dinostomp/schemas/items.schema.json",
  "title": "dinostomp item",
  "description": "One dataset item, after field mapping. One JSON object per JSONL line.",
  "type": "object",
  "required": ["id", "input", "target"],
  "properties": {
    "id": {
      "anyOf": [{"type": "string", "minLength": 1}, {"type": "integer"}],
      "description": "Unique within the dataset. The linter enforces uniqueness."
    },
    "input": {
      "description": "Plain prompt string, or a chat message list.",
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"enum": ["system", "user", "assistant"]},
              "content": {"type": "string"}
            }
          }
        }
      ]
    },
    "target": {
      "description": "Reference answer. A list means any listed answer is acceptable.",
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "array", "minItems": 1, "items": {"type": "string"}}
      ]
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string"},
      "description": "Present only for multiple-choice items. The linter runs position and length bias checks when present."
    },
    "metadata": {"type": "object"}
  }
}
